rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow public read access to receipts (for web receipt viewer)
    match /receipts/{receiptId} {
      allow read: if true;  // Public read for receipt viewer
      allow write: if false;  // Only Cloud Functions can write
    }

    // Allow public read access to mosque data (for branding in receipt viewer)
    match /mosques/{mosqueCode} {
      allow read: if true;  // Public read for branding data
      allow write: if false;  // Only admins/functions can write
    }

    // Keep payments secure (only accessible by Cloud Functions)
    match /mosques/{mosqueCode}/payments/{paymentId} {
      allow read, write: if false;  // Only Cloud Functions with Admin SDK
    }
  }
}
