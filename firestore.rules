rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Mosque-level documents
    match /mosques/{mosqueId} {
      allow read: if true;

      // UAT feedback submissions - allow full read/write access during UAT.
      // The dashboard auto-saves with setDoc (status: "in_progress") then
      // the final submit updates to "completed".  Previous rules were too
      // restrictive (status-field validation rejected writes where the form
      // used setDoc without merge or sent a status value like "submitted").
      // Keeping it open for UAT; tighten after UAT is complete.
      match /uat_submissions/{submissionId} {
        allow read, write: if true;
      }

      // Donations collection used by the Android kiosk app
      match /donations/{donationId} {
        allow read: if true;
        allow create: if true;
      }

      // General sub-collections (config, settings, etc.)
      match /{document=**} {
        allow read: if true;
      }
    }

    // Block everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
