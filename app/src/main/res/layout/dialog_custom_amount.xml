<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/white">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter Custom Amount"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary_green"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Amount Display -->
        <TextView
            android:id="@+id/amount_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="$0"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="@color/donation_button_teal"
            android:gravity="center"
            android:padding="20dp"
            android:background="@drawable/amount_display_background"
            android:layout_marginBottom="16dp" />

        <!-- Hidden input for value storage -->
        <EditText
            android:id="@+id/amount_input"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Keypad Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="4"
            android:layout_marginBottom="16dp">

            <!-- Row 1: 1, 2, 3 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_1"
                style="@style/KeypadButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_2"
                style="@style/KeypadButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_3"
                style="@style/KeypadButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="3" />

            <!-- Row 2: 4, 5, 6 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_4"
                style="@style/KeypadButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="4" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_5"
                style="@style/KeypadButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_6"
                style="@style/KeypadButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="6" />

            <!-- Row 3: 7, 8, 9 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_7"
                style="@style/KeypadButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="7" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_8"
                style="@style/KeypadButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_9"
                style="@style/KeypadButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="9" />

            <!-- Row 4: CLR, 0, Backspace -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear"
                style="@style/KeypadButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="CLR"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_0"
                style="@style/KeypadButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_backspace"
                style="@style/KeypadButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="⌫" />

        </GridLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textSize="18sp"
                android:textColor="@color/donation_button_teal"
                android:backgroundTint="@color/white"
                android:layout_marginEnd="8dp"
                app:strokeColor="@color/donation_button_teal"
                app:strokeWidth="2dp"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Confirm"
                android:textSize="18sp"
                android:textColor="@color/gold_text"
                android:backgroundTint="@color/donation_button_teal"
                android:layout_marginStart="8dp"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>