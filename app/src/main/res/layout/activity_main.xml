<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_light_background"
    android:padding="24dp"
    android:gravity="center"
    tools:context=".MainActivity">

    <!-- Settings Button (3 dots) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/btn_settings"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="end"
            android:text="⋮"
            android:textSize="36sp"
            android:textColor="@color/donation_button_teal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings" />
    </FrameLayout>

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.2"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Main Title -->
        <TextView
            android:id="@+id/main_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap to Give"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textColor="@color/donation_button_teal"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <!-- Arabic Title -->
        <TextView
            android:id="@+id/arabic_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="اضغط للتبرع"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/donation_button_teal"
            android:gravity="center" />

    </LinearLayout>

    <!-- 2x2 Grid for Preset Amounts -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.65"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">

        <!-- $10 Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_10"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="$10"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/gold_text"
            app:backgroundTint="@color/donation_button_teal"
            app:cornerRadius="16dp"
            android:elevation="4dp" />

        <!-- $25 Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_25"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="$25"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/gold_text"
            app:backgroundTint="@color/donation_button_teal"
            app:cornerRadius="16dp"
            android:elevation="4dp" />

        <!-- $50 Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_50"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="$50"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/gold_text"
            app:backgroundTint="@color/donation_button_teal"
            app:cornerRadius="16dp"
            android:elevation="4dp" />

        <!-- $100 Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_100"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:text="$100"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/gold_text"
            app:backgroundTint="@color/donation_button_teal"
            app:cornerRadius="16dp"
            android:elevation="4dp" />

    </GridLayout>

    <!-- Custom Amount Button (Full Width, Same Style) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_custom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.15"
        android:layout_margin="8dp"
        android:text="Custom Amount"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/gold_text"
        app:backgroundTint="@color/donation_button_teal"
        app:cornerRadius="16dp"
        android:elevation="4dp" />

</LinearLayout>